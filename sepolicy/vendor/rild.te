# Suppress noisy rild denials for core system files without violating neverallows
dontaudit rild radio_data_file:dir r_dir_perms;
dontaudit rild radio_data_file:file r_file_perms;
dontaudit rild vendor_data_file:dir r_dir_perms;
dontaudit rild vendor_data_file:file r_file_perms;
dontaudit rild unlabeled:dir r_dir_perms;
dontaudit rild unlabeled:file r_file_perms;
